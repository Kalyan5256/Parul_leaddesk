{
  "name": "parul_leaddesk",
  "version": "1.0.0",
  "description": "Parul LeadDesk Admission System",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm --prefix server install && npm --prefix server run build",
    "start": "npm --prefix server start"
  }
}
